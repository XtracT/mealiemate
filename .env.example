# MealieMate Configuration

# Mealie API
MEALIE_URL=http://your-mealie-host:9925
MEALIE_TOKEN=your-mealie-api-key

# MQTT Broker
MQTT_BROKER=your-mqtt-broker-ip
MQTT_PORT=1883

# Logging
LOG_LEVEL=INFO

# OpenAI (required if not using OpenRouter)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# OpenRouter (optional, alternative to OpenAI)
USE_OPENROUTER=false
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-r1-zero:free
